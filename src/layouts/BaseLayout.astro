---
import '../styles/global.css';
const { title = "Northlight Magazine", description = "Independent magazine" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-t="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#5b4bff">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&family=Lora:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
  <!-- Hidden SVG Icons for the UI -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
    <symbol id="i-home" viewBox="0 0 24 24"><path d="M3 11l9-8 9 8M5 10v10h5v-6h4v6h5V10"/></symbol>
    <symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></symbol>
    <symbol id="i-moon" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 019.5 4 8 8 0 1020 14.5z"/></symbol>
    <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
    <symbol id="i-tag" viewBox="0 0 24 24"><path d="M3 12V4a1 1 0 011-1h8l9 9-9 9z"/><circle cx="8" cy="8" r="1.5"/></symbol>
  </defs></svg>

  <!-- Top Navigation Bar -->
  <header>
    <div class="w">
      <div class="bar">
        <a class="logo" href="/">
          <span class="mk"><svg class="i"><use href="#i-arrow"/></svg></span>Northlight
        </a>
        <nav class="nav" id="nav">
          <a href="/">Home</a>
          <a href="/categories">Topics</a>
        </nav>
        <div class="sp"></div>
        <button class="ib th" aria-label="Toggle dark mode" onclick="document.documentElement.dataset.t = document.documentElement.dataset.t === 'dark' ? 'light' : 'dark'">
          <svg class="i moon"><use href="#i-moon"/></svg>
          <svg class="i sun"><use href="#i-sun"/></svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content Area (Posts go here) -->
  <main class="w" id="app" tabindex="-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer>
    <div class="w">
      <span>© 2026 Northlight Magazine</span>
      <nav class="flinks" aria-label="Footer">
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </footer>

  <!-- Mobile Bottom Navigation -->
  <nav class="bn" aria-label="Mobile">
    <a href="/" data-k="home"><svg class="i"><use href="#i-home"/></svg>Home</a>
    <a href="/categories" data-k="cats"><svg class="i"><use href="#i-grid"/></svg>Topics</a>
    <button class="th" onclick="document.documentElement.dataset.t = document.documentElement.dataset.t === 'dark' ? 'light' : 'dark'">
      <svg class="i moon"><use href="#i-moon"/></svg>
      <svg class="i sun"><use href="#i-sun"/></svg>
      Theme
    </button>
  </nav>

</body>
</html>