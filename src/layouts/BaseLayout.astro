---
const { title = "Northlight — Magazine", description = "Stories on technology, design, travel, lifestyle, culture and business." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#5b4bff">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27><rect width=%2732%27 height=%2732%27 rx=%278%27 fill=%27%235b4bff%27/><path d=%27M9 23V9l14 14V9%27 stroke=%27white%27 stroke-width=%273%27 fill=%27none%27/></svg>">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&family=Lora:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css" />
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
<symbol id="i-home" viewBox="0 0 24 24"><path d="M3 11l9-8 9 8M5 10v10h5v-6h4v6h5V10"/></symbol>
<symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></symbol>
<symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></symbol>
<symbol id="i-moon" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 019.5 4 8 8 0 1020 14.5z"/></symbol>
<symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></symbol>
<symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
<symbol id="i-eye" viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></symbol>
<symbol id="i-link" viewBox="0 0 24 24"><path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1M14 10a4 4 0 00-5.7 0l-3 3A4 4 0 0011 18.7l1-1"/></symbol>
<symbol id="i-share" viewBox="0 0 24 24"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 10.7l6.8-4M8.6 13.3l6.8 4"/></symbol>
<symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
<symbol id="i-close" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></symbol>
<symbol id="i-tag" viewBox="0 0 24 24"><path d="M3 12V4a1 1 0 011-1h8l9 9-9 9z"/><circle cx="8" cy="8" r="1.5"/></symbol>
<symbol id="i-doc" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6zM14 3v4h4M9 12h6M9 16h6"/></symbol>
<symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12l5 5 9-10"/></symbol>
<symbol id="i-cpu" viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/></symbol>
<symbol id="i-pen" viewBox="0 0 24 24"><path d="M4 20l4-1 11-11-3-3L5 16zM14 6l3 3"/></symbol>
<symbol id="i-plane" viewBox="0 0 24 24"><path d="M2 14l20-9-8 17-3-7z"/></symbol>
<symbol id="i-leaf" viewBox="0 0 24 24"><path d="M5 19C4 10 9 4 20 4c0 11-6 16-15 15zM5 19l8-8"/></symbol>
<symbol id="i-film" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 4v16M16 4v16M3 9h5M3 15h5M16 9h5M16 15h5"/></symbol>
<symbol id="i-chart" viewBox="0 0 24 24"><path d="M3 20h18M6 16v-5M11 16V6M16 16v-8"/></symbol>
</defs></svg>

<a class="skip" href="#app">Skip to content</a>
<div id="prog"></div>
<header><div class="w"><div class="bar">
  <a class="logo" href="/"><span class="mk"><svg class="i"><use href="#i-arrow"/></svg></span>Northlight</a>
  <nav class="nav" id="nav">
    <a href="/">Home</a>
    <a href="/categories">Topics</a>
    <a href="/tags">Tags</a>
    <a href="/about">About</a>
  </nav>
  <div class="sp"></div>
  <button class="sbtn" id="sb" aria-label="Search"><svg class="i"><use href="#i-search"/></svg><span>Search stories…</span><kbd>/</kbd></button>
  <button class="ib th" aria-label="Toggle dark mode"><svg class="i moon"><use href="#i-moon"/></svg><svg class="i sun"><use href="#i-sun"/></svg></button>
</div></div></header>

<main class="w" id="app" tabindex="-1">
  <slot />
</main>

<footer><div class="w"><span>© <span id="yr"></span> Northlight Magazine</span><nav class="flinks" aria-label="Footer"><a href="/about">About</a><a href="/contact">Contact</a></nav></div></footer>

<nav class="bn" aria-label="Mobile">
  <a href="/"><svg class="i"><use href="#i-home"/></svg>Home</a>
  <a href="/categories"><svg class="i"><use href="#i-grid"/></svg>Topics</a>
  <button id="sb2"><svg class="i"><use href="#i-search"/></svg>Search</button>
  <button class="th"><svg class="i moon"><use href="#i-moon"/></svg><svg class="i sun"><use href="#i-sun"/></svg>Theme</button>
</nav>

<div id="so" role="dialog" aria-modal="true" aria-label="Search">
  <div class="sm">
    <div class="si"><svg class="i"><use href="#i-search"/></svg><input id="sq" autocomplete="off" placeholder="Search titles, topics, tags or any line in a story" aria-label="Search"><button id="sx">Esc</button></div>
    <div class="sr" id="sr"></div>
  </div>
</div>

<script is:inline>
  const $ = s => document.querySelector(s);
  
  // Theme Toggle
  document.querySelectorAll('.th').forEach(b => b.onclick = () => {
    const d = document.documentElement, n = d.dataset.t === 'dark' ? 'light' : 'dark';
    d.dataset.t = n;
    try { localStorage.setItem('t', n) } catch (e) {}
  });
  try { document.documentElement.dataset.t = localStorage.getItem('t') || (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light') } catch (e) { document.documentElement.dataset.t = 'light' }
  
  // Progress & Footer Year
  addEventListener('scroll', () => { const h = document.documentElement; $('#prog').style.width = (h.scrollTop / (h.scrollHeight - h.clientHeight || 1) * 100) + '%' }, { passive: true });
  if ($('#yr')) $('#yr').textContent = new Date().getFullYear();

  // Search Logic
  let searchData = [];
  let lastFocus = null;
  const sq = $('#sq'), sr = $('#sr'), so = $('#so');

  const openSearch = async () => { 
    lastFocus = document.activeElement;
    so.classList.add('on'); 
    document.body.style.overflow = 'hidden';
    if (!searchData.length) {
      const res = await fetch('/search.json');
      searchData = await res.json();
    }
    sq.value = '';
    sr.innerHTML = '';
    setTimeout(() => sq.focus(), 30);
  };
  
  const closeSearch = () => { 
    so.classList.remove('on'); 
    document.body.style.overflow = '';
    if (lastFocus && lastFocus.focus) lastFocus.focus(); 
  };
  
  if ($('#sb')) $('#sb').onclick = openSearch;
  if ($('#sb2')) $('#sb2').onclick = openSearch;
  if ($('#sx')) $('#sx').onclick = closeSearch;
  so.addEventListener('click', e => { if (e.target.id === 'so') closeSearch() });
  
  sq.addEventListener('input', (e) => {
    const q = e.target.value.toLowerCase().trim();
    if (!q) { sr.innerHTML = ''; return; }
    const hits = searchData.filter(p => p.title.toLowerCase().includes(q) || (p.category && p.category.toLowerCase().includes(q)) || (p.tags && p.tags.some(t => t.toLowerCase().includes(q))));
    
    sr.innerHTML = hits.length ? hits.map(p => `
      <a class="hit" href="/post/${p.slug}">
        <div class="art" style="background:linear-gradient(135deg,${p.color[0]},${p.color[1]})"><svg viewBox="0 0 24 24"><use href="#i-${p.icon}"/></svg></div>
        <div><b>${p.title}</b><q>${p.category}</q></div>
      </a>
    `).join('') : `<div class="none"><p>No stories match.</p></div>`;
  });
</script>
</body>
</html>