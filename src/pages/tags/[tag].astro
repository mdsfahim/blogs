---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = Object.values(import.meta.glob('../../content/*.md', { eager: true }));
  // Flatten and extract all unique tags
  const tags = [...new Set(posts.flatMap((p: any) => p.frontmatter.tags || []))];
  
  return tags.map(tag => ({
    params: { tag },
    props: { posts: posts.filter((p: any) => p.frontmatter.tags?.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---
<BaseLayout title={`Tag: ${tag}`}>
  <div class="page">
    <h1>Posts tagged: #{tag}</h1>
    <div class="grid">
      {posts.map((post: any) => (
         <a class="card" href={`/post/${post.file.split('/').pop().replace('.md', '')}`}>
            <div class="b"><h3>{post.frontmatter.title}</h3></div>
         </a>
      ))}
    </div>
  </div>
</BaseLayout>