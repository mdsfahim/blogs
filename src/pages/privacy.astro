---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Privacy Policy - Northlight">
  <div class="page">
    <span class="crumb"><a href="/">Home</a> / Privacy Policy</span>
    <h1>Privacy Policy</h1>
    <p>Replace this text with your own policy. It should explain what data the site collects, how cookies are used, which advertising and analytics partners you work with, and how visitors can contact you or request removal of their data.</p>
    <h2>Advertising and cookies</h2>
    <p>If you use ad networks, list them here and explain how visitors can opt out of personalized ads.</p>
  </div>
</BaseLayout>