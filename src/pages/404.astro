---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 - Page Not Found">
  <div class="page" style="text-align:center; padding:120px 0;">
    <h1 style="font-size:80px; margin:0; color:var(--ac)">404</h1>
    <p>We couldn't find the page you were looking for.</p>
    <a href="/" class="more">Return Home</a>
  </div>
</BaseLayout>