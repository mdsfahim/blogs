---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdUnit from '../components/AdUnit.astro';

// Fetch all markdown posts
const posts = Object.values(import.meta.glob('../content/*.md', { eager: true }));
---

<BaseLayout title="Northlight — Magazine">
  
  <!-- Topic Categories Grid -->
  <div class="h2"><h2>Topics</h2><a href="/categories">All topics <svg class="i"><use href="#i-arrow"/></svg></a></div>
  <div class="cgrid">
    <a class="ct" style="background:linear-gradient(135deg,#5b4bff,#8f7bff)" href="/category/tech">
      <svg class="i"><use href="#i-cpu"/></svg><div>Tech<br><small>View stories</small></div>
    </a>
    <a class="ct" style="background:linear-gradient(135deg,#ff5d8f,#ff9a6c)" href="/category/design">
      <svg class="i"><use href="#i-pen"/></svg><div>Design<br><small>View stories</small></div>
    </a>
    <a class="ct" style="background:linear-gradient(135deg,#0ea5a5,#4ad6b8)" href="/category/travel">
      <svg class="i"><use href="#i-plane"/></svg><div>Travel<br><small>View stories</small></div>
    </a>
  </div>

  <div class="two">
    <!-- Main Content Area (Left) -->
    <div>
      <div class="h2"><h2>Latest stories</h2></div>
      <div class="grid">
        {posts.map((post: any) => (
          <a class="card" href={`/post/${post.file.split('/').pop().replace('.md', '')}`}>
            <div class="art" style="background:linear-gradient(135deg,#5b4bff,#8f7bff)">
              <svg viewBox="0 0 24 24"><use href="#i-cpu"/></svg>
            </div>
            <div class="b">
              <span><span class="badge" style="background:#5b4bff">{post.frontmatter.category}</span></span>
              <h3>{post.frontmatter.title}</h3>
              <p>Read full story...</p>
              <div class="meta">
                <span>{post.frontmatter.author}</span>
                <span><svg class="i"><use href="#i-clock"/></svg>5 min read</span>
                <span>{post.frontmatter.date}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Sidebar Area (Right) -->
    <aside>
      <AdUnit format="300x250" />
      
      <div class="box">
        <h3>Popular tags</h3>
        <div class="chips">
          <a href="/tags/web"><svg class="i"><use href="#i-tag"/></svg>web</a>
          <a href="/tags/design"><svg class="i"><use href="#i-tag"/></svg>design</a>
          <a href="/tags/tech"><svg class="i"><use href="#i-tag"/></svg>tech</a>
        </div>
      </div>
      
      <div class="ad2 stick">
        <AdUnit format="160x600" />
      </div>
    </aside>
  </div>
</BaseLayout>