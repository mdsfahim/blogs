---
import BaseLayout from '../layouts/BaseLayout.astro';

// Fetch all posts and extract a unique list of all tags
const posts = Object.values(import.meta.glob('../content/*.md', { eager: true }));
const tags = [...new Set(posts.flatMap((p: any) => p.frontmatter.tags || []))];
---

<BaseLayout title="All Tags">
  <div class="page">
    <h1>All Tags</h1>
    <div class="chips">
      {tags.map(tag => (
        <a href={`/tags/${tag}`}>
          <svg class="i"><use href="#i-tag"/></svg>{tag}
        </a>
      ))}
    </div>
  </div>
</BaseLayout>